FROM ghcr.io/cirruslabs/flutter:stable AS build
WORKDIR /app
COPY . .
# Generate the standard Flutter web scaffold when this mobile-first project has none.
RUN flutter create --platforms=web .
RUN flutter pub get
RUN flutter build web --release --dart-define=TRADINGAGENTS_BACKEND_URL=https://tradingagents-backend-i0a1.onrender.com

FROM nginx:1.27-alpine
COPY nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html
EXPOSE 10000
